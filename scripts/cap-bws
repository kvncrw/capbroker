#!/usr/bin/env sh
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Brokered Bitwarden Secrets Manager (BSM) read.
#
# Usage:
#   cap-bws secret get <UUID>
#   cap-bws secret list
#
# The BSM secret UUID is auto-derived from the args (last positional arg
# matching a UUID, or 'list' for the no-resource list operation). The
# capbroker daemon resolves BWS_ACCESS_TOKEN from the bws_access_token_from_cluster
# secret source and injects it into env before exec-ing bws.
set -eu

server_file="${CAPBROKER_SERVER_FILE:-/opt/data/capbroker-server}"
if [ -z "${CAPBROKER_SERVER:-}" ] && [ -f "$server_file" ]; then
  CAPBROKER_SERVER="$(sed -n '1p' "$server_file")"
  export CAPBROKER_SERVER
fi

if [ -z "${CAPBROKER_SERVER:-}" ]; then
  echo "cap-bws requires CAPBROKER_SERVER or $server_file" >&2
  exit 2
fi

uuid_re='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'

resource=""
for arg in "$@"; do
  if echo "$arg" | grep -Eq "$uuid_re"; then
    resource="$arg"
    break
  fi
done

# `bws secret list` has no per-secret resource — broker against a
# stable sentinel so audit still records the call.
if [ -z "$resource" ]; then
  case "${1:-} ${2:-}" in
    "secret list"*)
      resource="bsm/list"
      ;;
  esac
fi

if [ -z "$resource" ]; then
  echo "cap-bws requires a BSM secret UUID in args, or 'secret list'" >&2
  exit 2
fi

reason="${CAPBROKER_REASON:-bws $*}"
ttl_args=""
if [ -n "${CAPBROKER_SESSION_TTL:-}" ]; then
  ttl_args="--session-ttl ${CAPBROKER_SESSION_TTL}"
fi
# shellcheck disable=SC2086
exec capbroker remote-run \
  --agent "${CAPBROKER_AGENT:-remote-agent}" \
  --profile "${CAPBROKER_PROFILE:-bws-read}" \
  --resource "$resource" \
  --reason "$reason" \
  $ttl_args \
  -- bws "$@"
