#!/usr/bin/env bash
# bash (not sh) because the 403-breadcrumb path uses process substitution
# (`2> >(tee ...)`) to capture stderr while still letting the user see it.
# That syntax is bash-only — under dash/ash this script would fail to
# parse before reaching the kubectl call.
set -euo pipefail

server_file="${CAPBROKER_SERVER_FILE:-/opt/data/capbroker-server}"
if [ -z "${CAPBROKER_SERVER:-}" ] && [ -f "$server_file" ]; then
  CAPBROKER_SERVER="$(sed -n '1p' "$server_file")"
  export CAPBROKER_SERVER
fi

if [ -z "${CAPBROKER_SERVER:-}" ]; then
  echo "cap-kubectl requires CAPBROKER_SERVER or $server_file" >&2
  exit 2
fi

namespace=""
prev=""
for arg in "$@"; do
  if [ "$prev" = "-n" ] || [ "$prev" = "--namespace" ]; then
    namespace="$arg"
    break
  fi
  case "$arg" in
    -n=*) namespace="${arg#-n=}" ;;
    --namespace=*) namespace="${arg#--namespace=}" ;;
  esac
  prev="$arg"
done

if [ -z "$namespace" ]; then
  namespace="${CAPBROKER_KUBECTL_NAMESPACE:-default}"
fi

reason="${CAPBROKER_REASON:-kubernetes $*}"
ttl_args=""
if [ -n "${CAPBROKER_SESSION_TTL:-}" ]; then
  ttl_args="--session-ttl ${CAPBROKER_SESSION_TTL}"
fi
denied_log="${CAPBROKER_DENIED_LOG:-/opt/data/capbroker-denied.jsonl}"
target_profile="${CAPBROKER_PROFILE:-k8s-read}"
target_resource="namespace/$namespace"

stderr_capture="$(mktemp)"
trap 'rm -f "$stderr_capture"' EXIT

set +e
# shellcheck disable=SC2086
capbroker remote-run \
  --agent "${CAPBROKER_AGENT:-remote-agent}" \
  --profile "$target_profile" \
  --resource "$target_resource" \
  --reason "$reason" \
  $ttl_args \
  -- kubectl "$@" 2> >(tee "$stderr_capture" >&2)
status=$?
set -e

# On a 403-style denial, drop a structured breadcrumb the agent's next
# wake handler can pick up to surface "you have outstanding capability
# gaps". Best-effort throughout: a missing python3, missing log dir,
# unwritable log file, or any encoding hiccup must NEVER change the
# exit code the caller sees — kubectl's denial is the meaningful
# signal, the breadcrumb is the convenience.
#
# JSON encoding is delegated to python3 (json.dumps) so backslashes,
# control characters, and embedded quotes in kubectl args (think
# JSONPath like `-o jsonpath='{.spec.containers[0].image}'`) don't
# corrupt the breadcrumb. argv arrives NUL-delimited on stdin so any
# shell-special bytes survive intact.
if [ "$status" -ne 0 ] && grep -q 'is not allowed for profile' "$stderr_capture"; then
  log_dir="$(dirname "$denied_log")"
  if [ -d "$log_dir" ] && command -v python3 >/dev/null 2>&1; then
    msg="$(grep 'is not allowed for profile' "$stderr_capture" | head -1 || true)"
    {
      printf '%s\0' "$@" | \
        CAPBROKER_DENIED_AGENT="${CAPBROKER_AGENT:-remote-agent}" \
        CAPBROKER_DENIED_PROFILE="$target_profile" \
        CAPBROKER_DENIED_RESOURCE="$target_resource" \
        CAPBROKER_DENIED_STDERR="$msg" \
        python3 -c '
import json, os, sys
from datetime import datetime, timezone
items = sys.stdin.buffer.read().split(b"\0")
items = [b.decode("utf-8", "replace") for b in items if b]
print(json.dumps({
    "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "agent": os.environ["CAPBROKER_DENIED_AGENT"],
    "target_profile": os.environ["CAPBROKER_DENIED_PROFILE"],
    "target_resource": os.environ["CAPBROKER_DENIED_RESOURCE"],
    "argv": ["kubectl", *items],
    "stderr": os.environ["CAPBROKER_DENIED_STDERR"],
}))
' >> "$denied_log"
    } 2>/dev/null || true
  fi
fi

exit "$status"
