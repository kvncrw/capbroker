#!/usr/bin/env sh
set -eu

repo=""
prev=""
for arg in "$@"; do
  if [ "$prev" = "--repo" ] || [ "$prev" = "-R" ]; then
    repo="$arg"
    break
  fi
  case "$arg" in
    --repo=*) repo="${arg#--repo=}" ;;
    -R=*) repo="${arg#-R=}" ;;
  esac
  prev="$arg"
done

if [ -z "$repo" ]; then
  echo "cap-gh requires --repo OWNER/REPO or -R OWNER/REPO" >&2
  exit 2
fi

reason="${CAPBROKER_REASON:-github $*}"
ttl_args=""
if [ -n "${CAPBROKER_SESSION_TTL:-}" ]; then
  ttl_args="--session-ttl ${CAPBROKER_SESSION_TTL}"
fi
# shellcheck disable=SC2086
exec capbroker remote-run \
  --agent "${CAPBROKER_AGENT:-remote-agent}" \
  --profile "${CAPBROKER_PROFILE:-github-review}" \
  --resource "$repo" \
  --reason "$reason" \
  $ttl_args \
  -- gh "$@"
