#!/usr/bin/env sh
set -eu

server_file="${CAPBROKER_SERVER_FILE:-/opt/data/capbroker-server}"
if [ -z "${CAPBROKER_SERVER:-}" ] && [ -f "$server_file" ]; then
  CAPBROKER_SERVER="$(sed -n '1p' "$server_file")"
  export CAPBROKER_SERVER
fi

if [ -z "${CAPBROKER_SERVER:-}" ]; then
  echo "cap-gh requires CAPBROKER_SERVER or $server_file" >&2
  exit 2
fi

repo=""
prev=""
for arg in "$@"; do
  if [ "$prev" = "--repo" ] || [ "$prev" = "-R" ]; then
    repo="$arg"
    break
  fi
  case "$arg" in
    --repo=*) repo="${arg#--repo=}" ;;
    -R=*) repo="${arg#-R=}" ;;
  esac
  prev="$arg"
done

if [ -z "$repo" ] && [ "${1:-}" = "repo" ]; then
  case "${2:-}" in
    view|clone|fork)
      case "${3:-}" in
        */*) repo="$3" ;;
      esac
      ;;
  esac
fi

if [ -z "$repo" ]; then
  echo "cap-gh requires --repo OWNER/REPO, -R OWNER/REPO, or gh repo view/clone/fork OWNER/REPO" >&2
  exit 2
fi

reason="${CAPBROKER_REASON:-github $*}"
ttl_args=""
if [ -n "${CAPBROKER_SESSION_TTL:-}" ]; then
  ttl_args="--session-ttl ${CAPBROKER_SESSION_TTL}"
fi
# shellcheck disable=SC2086
exec capbroker remote-run \
  --agent "${CAPBROKER_AGENT:-remote-agent}" \
  --profile "${CAPBROKER_PROFILE:-github-review}" \
  --resource "$repo" \
  --reason "$reason" \
  $ttl_args \
  -- gh "$@"
